{
  "name": "dmt-software/ubl-service",
  "description": "Service to handle UBL documents",
  "type": "library",
  "license": "MIT",
  "minimum-stability": "stable",
  "authors": [
    {
      "name": "Bas de Mes",
      "email": "bas@dmt-software.nl"
    }
  ],
  "require": {
    "php": ">=8.3",
    "jms/serializer": "^3.32",
    "ext-simplexml": "*"
  },
  "autoload": {
    "psr-4": {
      "DMT\\Ubl\\Service\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "jawira/case-converter": "^3.6",
    "ext-zip": "*",
    "nikic/php-parser": "^5.7",
    "ext-dom": "*"
  },
  "autoload-dev": {
    "psr-4": {
      "DMT\\Test\\Ubl\\Service\\": "tests/",
      "DMT\\Ubl\\Generate\\": "generate-src/"
    }
  },
  "scripts": {
    "generate": "bin/generate.php"
  }
}
